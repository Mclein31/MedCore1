{
  "name": "medcore-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite --config apps/dashboard/vite.config.ts",
    "dev:server": "npx tsx apps/server/src/standalone.ts",
    "build": "tsc -p apps/dashboard/tsconfig.json && vite build --config apps/dashboard/vite.config.ts",
    "preview": "vite preview --config apps/dashboard/vite.config.ts",
    "seed": "npx tsx scripts/seedPostgres.ts",
    "test": "node --import ./node_modules/tsx/dist/loader.mjs scripts/testProject.ts",
    "test:api": "NODE_ENV=test npx tsx scripts/seedPostgres.ts && NODE_ENV=test npx tsx scripts/testBackendApi.ts",
    "test:ai": "NODE_ENV=test npx tsx apps/server/__tests__/aiServices.test.ts",
    "test:ai:live": "npx tsx scripts/testLiveAi.ts",
    "test:financial": "node --import ./node_modules/tsx/dist/loader.mjs scripts/auditFinancials.ts",
    "test:claims": "node --import ./node_modules/tsx/dist/loader.mjs apps/dashboard/__tests__/claimsEsoa.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.9.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.13.12",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "wrangler": "^4.144.0"
  }
}
