{
  "name": "medcore",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "MedCore: financial clearance and patient billing middleware for Philippine hospitals.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm run dev -w @medcore/api\" \"npm run dev -w @medcore/web\"",
    "build": "npm run build -w @medcore/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @medcore/api",
    "db:seed": "npm run db:seed -w @medcore/api",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
