# ==============================================================================
# MEDCORE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (Vite / Vercel Web Dashboard)
# ------------------------------------------------------------------------------
# In local development: leave blank to use the Vite dev proxy (/api -> http://127.0.0.1:8787)
# In Vercel deployment: set to your deployed Cloudflare Worker URL
# (e.g. https://medcore-backend.mcleinonza0531.workers.dev)
VITE_API_BASE_URL=
# Legacy alias:
VITE_API_URL=

# ------------------------------------------------------------------------------
# 2. BACKEND CONFIGURATION (Node.js / Hono Standalone / Serverless)
# ------------------------------------------------------------------------------
PORT=8787
NODE_ENV=development

# PostgreSQL Connection String (Neon, Supabase, RDS, or local Postgres)
DATABASE_URL=postgresql://username:password@localhost:5432/medcore_db?sslmode=prefer

# Allowed Origins for Cross-Origin Resource Sharing (CORS)
# Comma-separated list of origins. Vercel preview domains (*.vercel.app) are allowed automatically.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Secret for HMAC cryptographic digital exit passes (under RA 9439)
# In production, set via: wrangler secret put GATE_PASS_SECRET
GATE_PASS_SECRET=your_secure_gate_pass_hmac_secret_here

# Future Mobile App Configuration Notes:
# Native iOS (Xcode) and Android (Android Studio) clients do not require CORS origins,
# but can point their API_BASE_URL to this same backend API endpoint.
