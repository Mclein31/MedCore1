# MedCore configuration. Copy to .env for local development; never commit .env.
# Every value below is a placeholder. The API refuses to start with missing or weak secrets.

# production | development | test. Unset means production (the safe default).
APP_ENV=development

# Use the direct (unpooled) URL for migrations.
DATABASE_URL=postgres://localhost:5432/medcore

# Where the web app is served. Used for CORS/CSRF origin checks and email links.
PUBLIC_APP_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# openssl rand -hex 32
GATE_PASS_SECRET=
# openssl rand -base64 32   (32 random bytes; encrypts PhilHealth PINs, IDs, phones, MFA secrets)
DATA_ENCRYPTION_KEY=

# Staff two-step sign-in. Cannot be turned off in production.
STAFF_MFA_REQUIRED=true

# There is no live payment gateway. "simulated" lets patients try the online flow (demo only).
PATIENT_ONLINE_PAYMENTS=disabled
PATIENT_ONLINE_PROMISSORY=false

# Email. "console" prints messages to the API log and is refused in production.
MAIL_TRANSPORT=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# A Google App Password (needs 2-Step Verification on that account). Never a VITE_* variable.
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=MedCore

# PBKDF2 iterations for new password hashes (Cloudflare Workers allows at most 100000).
PASSWORD_PBKDF2_ITERATIONS=600000

# none | cloudflare | x-forwarded-for. Only trust a header your own proxy sets.
TRUST_PROXY=none
HOST=127.0.0.1
PORT=8787

# Seed only (npm run db:seed). Must pass the password policy (12+ chars, not common).
SEED_PASSWORD=
# Optional: an inbox you control; patients become you+mrn-240100@... aliases.
SEED_PATIENT_EMAIL=

# Optional: Gemini AI credentials for Cora concierge, card OCR, claims scrubber, HMO appeal drafter, and executive briefing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BACKUP_MODEL=gemini-2.5-flash-lite
GEMINI_PRO_MODEL=gemini-2.5-pro

