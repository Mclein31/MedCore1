# ==============================================================================
# MEDCORE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# 1. FRONTEND CONFIGURATION (Vite / Vercel Web Dashboard)
VITE_API_BASE_URL=
VITE_DEBUG=true

# 2. BACKEND CONFIGURATION (Node.js / Hono Standalone / Serverless)
PORT=8787
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/aqromed
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
# Generate with: openssl rand -hex 32
GATE_PASS_SECRET=

# 3. AI SUITE CONFIGURATION (Google Gemini & Multimodal Inference)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BACKUP_MODEL=gemini-3.1-flash-lite
GEMINI_PRO_MODEL=gemini-3.1-flash-lite
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# 4. DEMO / SEED CONFIGURATION
# Password given to every seeded account by scripts/seedPostgres.ts (required, 12+ chars).
# Test scripts read the same variable to sign in.
SEED_PASSWORD=
# Enables the mobile demo CFO principal (patient directory + impersonation). Off unless 'true'.
MOBILE_DEMO_ENABLED=false

# 5. PATIENT EMAIL SIGN-IN CODES (Gmail SMTP with an App Password)
# Hosted: set with `npx wrangler secret put SMTP_USER` / `SMTP_PASSWORD` (never VITE_*).
# Local: leave blank with NODE_ENV=development and the code is printed to the API log.
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=
SMTP_PORT=
MAIL_FROM=
MAIL_FROM_NAME=MedCore
