# 1. FRONTEND CONFIGURATION (Vite / Vercel Web Dashboard)
VITE_API_BASE_URL=
VITE_DEBUG=true

# 2. BACKEND CONFIGURATION (Node.js / Hono Standalone / Serverless)
PORT=8787
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/aqromed
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
GATE_PASS_SECRET=1fb38c2ffa6e38395ca83e9cef986515c27d5507f78dc9af32c8b3eff3e83954

# 3. AI SUITE CONFIGURATION (Google Gemini & Multimodal Inference)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
