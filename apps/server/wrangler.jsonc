{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "medcore-backend",
	"main": "src/index.ts",
	"compatibility_date": "2024-09-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"NODE_ENV": "production",
		"GEMINI_API_KEY": "AQ.Ab8RN6JUvmXJ7s4GwFU6xvrRl43RG_azAj87NEvDQ13R_8KAnQ",
		"GEMINI_MODEL": "gemini-3.5-flash-lite",
		"GEMINI_BACKUP_MODEL": "gemini-3.1-flash-lite",
		"GEMINI_PRO_MODEL": "gemini-3.1-flash-lite"
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "b611eac58efa4966b649dfa7d1631b2a",
			"localConnectionString": "postgresql://mclein@localhost:5432/aqromed"
		}
	],
	"r2_buckets": [
		{
			"binding": "DOCUMENTS_BUCKET",
			"bucket_name": "aqromed-documents"
		}
	]
}
