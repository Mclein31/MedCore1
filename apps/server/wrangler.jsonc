{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "medcore-backend",
	"main": "src/index.ts",
	"compatibility_date": "2024-09-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"NODE_ENV": "production",
		"GEMINI_MODEL": "gemini-3.8-flash",
		"GEMINI_PRO_MODEL": "gemini-1.5-pro-latest"
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "b611eac58efa4966b649dfa7d1631b2a",
			"localConnectionString": "postgresql://mclein@localhost:5432/aqromed"
		}
	],
	"r2_buckets": [
		{
			"binding": "DOCUMENTS_BUCKET",
			"bucket_name": "aqromed-documents"
		}
	]
}
