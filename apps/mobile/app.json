{
  "expo": {
    "name": "MedCore",
    "slug": "medcore-patient",
    "scheme": "medcore",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ph.medcore.patient",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ph.medcore.patient",
      "adaptiveIcon": {
        "backgroundColor": "#F5F8F7",
        "foregroundImage": "./assets/brand/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/brand/MedCore_Badge_Logo.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a benefit card photo for credential extraction.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/MedCore_Badge_Logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F2A4A"
        }
      ]
    ]
  }
}
