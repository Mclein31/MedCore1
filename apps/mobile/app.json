{
  "expo": {
    "name": "MedCore",
    "slug": "medcore-patient",
    "scheme": "medcore",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/MedCore_Badge_Logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F2A4A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ph.medcore.patient",
      "config": { "usesNonExemptEncryption": false }
    },
    "android": {
      "package": "ph.medcore.patient",
      "adaptiveIcon": { "backgroundColor": "#F5F8F7", "foregroundImage": "./assets/adaptive-icon.png" },
      "allowBackup": false
    },
    "plugins": ["expo-secure-store"]
  }
}
