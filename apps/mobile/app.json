{
  "expo": {
    "name": "MedCore",
    "slug": "medcore-patient",
    "scheme": "medcore",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/brand/MedCore_Badge_Logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F8F7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ph.medcore.patient"
    },
    "android": {
      "package": "ph.medcore.patient",
      "adaptiveIcon": {
        "backgroundColor": "#F5F8F7",
        "foregroundImage": "./assets/brand/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/brand/MedCore_Badge_Logo.png"
    }
  }
}
