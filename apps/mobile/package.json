{
  "name": "@medcore/mobile",
  "version": "2.0.0",
  "private": true,
  "main": "index.ts",
  "description": "MedCore patient app (Expo). Talks only to the v2 API with a bearer token kept in the OS keychain.",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "native:prebuild": "expo prebuild --clean --no-install && npm pkg set 'scripts.ios=expo start --ios' 'scripts.android=expo start --android' && cd ios && pod install",
    "ios:release": "expo run:ios --configuration Release --no-bundler",
    "ios:device": "expo run:ios --device --configuration Release --no-bundler",
    "android:release": "cd android && ANDROID_HOME=${ANDROID_HOME:-$HOME/Library/Android/sdk} JAVA_HOME=${JAVA_HOME:-$(/usr/libexec/java_home -v 21)} ./gradlew assembleRelease",
    "android:install": "${ANDROID_HOME:-$HOME/Library/Android/sdk}/platform-tools/adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@medcore/domain": "*",
    "@medcore/icons": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@tanstack/react-query": "^5.104.3",
    "expo": "~58.0.25",
    "expo-crypto": "~58.0.8",
    "expo-image-picker": "~58.0.10",
    "expo-notifications": "~58.1.9",
    "expo-secure-store": "~58.0.3",
    "expo-speech-recognition": "^58.0.1",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.3.0",
    "vitest": "^5.0.5"
  }
}
