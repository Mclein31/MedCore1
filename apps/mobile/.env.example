# Copy to .env for local development. Never commit .env or secrets.
# Local backend (same machine as `npm run dev:server` on port 8787):
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8787
# Production backend (Cloudflare Worker):
# EXPO_PUBLIC_API_BASE_URL=https://medcore-backend.mcleinonza0531.workers.dev
# Hospital facility code issued on the admission slip:
EXPO_PUBLIC_FACILITY_CODE=SJMC-MNL
# DATA_MODE is reserved for a development-only demo abstraction.
# Production builds must always use live backend data.
EXPO_PUBLIC_DATA_MODE=live
