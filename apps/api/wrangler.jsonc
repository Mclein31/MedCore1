// Cloudflare Workers deployment for the MedCore v2 API.
// Secrets (never in this file): wrangler secret put GATE_PASS_SECRET / DATA_ENCRYPTION_KEY / SMTP_USER / SMTP_PASSWORD
{
  "name": "medcore-backend",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "hyperdrive": [
    // Point at the Neon DIRECT (unpooled) endpoint with caching disabled: money must never be served stale.
    { "binding": "HYPERDRIVE", "id": "b611eac58efa4966b649dfa7d1631b2a" },
  ],
  "vars": {
    "APP_ENV": "production",
    "PUBLIC_APP_URL": "https://med-core1.vercel.app",
    "ALLOWED_ORIGINS": "https://med-core1.vercel.app,https://medcore1.vercel.app",
    "STAFF_MFA_REQUIRED": "true",
    "PATIENT_ONLINE_PAYMENTS": "simulated",
    "PATIENT_ONLINE_PROMISSORY": "true",
    "MAIL_TRANSPORT": "smtp",
    "MAIL_FROM_NAME": "MedCore",
    // 3.1 answers in ~2 s on the free tier; 3.5 took 7–25 s (2026-10-28), so it is the backup.
    "GEMINI_MODEL": "gemini-3.1-flash-lite",
    "GEMINI_BACKUP_MODEL": "gemini-3.5-flash-lite",
    "GEMINI_PRO_MODEL": "gemini-3.1-flash-lite",
    // Workers caps PBKDF2 at 100,000 iterations.
    "PASSWORD_PBKDF2_ITERATIONS": "100000",
  },
  // Hourly purge of expired codes, challenges, rate-limit buckets and old sessions.
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": true },
  // Philippine traffic lands in Cloudflare's Hong Kong colo, where Google rejects Gemini calls
  // (unsupported location, HTTP 400). Run next to Singapore instead, which is also where Neon lives.
  "placement": { "region": "gcp:asia-southeast1" },
}
